@page
@model PlacementManagementSystem.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Student Registration</h3>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        Create your Placement Management System account.
                    </p>

                    <form method="post" asp-antiforgery="true">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Full Name -->

                        <div class="mb-3">

                            <label asp-for="Input.FullName"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.FullName"
                                   class="form-control"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="Input.FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Email -->

                        <div class="mb-3">

                            <label asp-for="Input.Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Roll Number -->

                        <div class="mb-3">

                            <label asp-for="Input.RollNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.RollNumber"
                                   class="form-control"
                                   placeholder="Enter your roll number" />

                            <span asp-validation-for="Input.RollNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Department -->

                        <div class="mb-3">

                            <label asp-for="Input.Department"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Department"
                                   class="form-control"
                                   placeholder="Enter your department" />

                            <span asp-validation-for="Input.Department"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Password -->

                        <div class="mb-3">

                            <label asp-for="Input.Password"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   placeholder="Create a password" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Confirm Password -->

                        <div class="mb-3">

                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm your password" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100">

                            Create Student Account

                        </button>

                    </form>


                    <div class="text-center mt-3">

                        <a asp-page="/Account/Login"
                           asp-area="Identity">

                            Already have an account? Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}