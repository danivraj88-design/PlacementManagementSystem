@page
@model PlacementManagementSystem.Areas.Identity.Pages.Account.ChooseRoleModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Choose Account Type";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-dark text-white text-center">
                    <h2 class="mb-0">Placement Management System</h2>
                </div>

                <div class="card-body p-5">

                    <h3 class="text-center mb-2">
                        Choose Account Type
                    </h3>

                    <p class="text-center text-muted mb-4">
                        Select how you want to access the placement management system.
                    </p>

                    <!-- Student -->

                    <div class="card mb-3 border">
                        <div class="card-body">
                            <h5 class="card-title">
                                🎓 Student
                            </h5>

                            <p class="card-text text-muted">
                                View placement drives, maintain your profile,
                                and apply for available jobs.
                            </p>

                            <a asp-page="/Account/Login"
                               asp-route-role="Student"
                               class="btn btn-primary w-100 mb-2">
                                Student Login
                            </a>

                            <a asp-page="/Account/Register"
                               class="btn btn-outline-primary w-100">
                                Student Registration
                            </a>
                        </div>
                    </div>

                    <!-- TPO -->

                    <div class="card mb-3 border">
                        <div class="card-body">
                            <h5 class="card-title">
                                👨‍💼 Training & Placement Officer
                            </h5>

                            <p class="card-text text-muted">
                                Manage students, companies, placement drives,
                                and recruitment activities.
                            </p>

                            <a asp-page="/Account/Login"
                               asp-route-role="TPO"
                               class="btn btn-success w-100 mb-2">
                                TPO Login
                            </a>

                            <a asp-page="/Account/TPORegister"
                               class="btn btn-outline-success w-100">
                                TPO Registration
                            </a>
                        </div>
                    </div>

                    <!-- Company -->

                    <div class="card mb-3 border">
                        <div class="card-body">
                            <h5 class="card-title">
                                🏢 Company
                            </h5>

                            <p class="card-text text-muted">
                                Register your company, create job openings,
                                and manage student applications.
                            </p>

                            <a asp-page="/Account/Login"
                               asp-route-role="Company"
                               class="btn btn-dark w-100 mb-2">
                                Company Login
                            </a>

                            <a asp-page="/Account/CompanyRegister"
                               class="btn btn-outline-dark w-100">
                                Company Registration
                            </a>
                        </div>
                    </div>

                </div>

                <div class="card-footer text-center text-muted">
                    Placement Management System
                </div>

            </div>

        </div>
    </div>
</div>