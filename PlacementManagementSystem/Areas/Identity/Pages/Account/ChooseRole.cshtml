@page
@model PlacementManagementSystem.Areas.Identity.Pages.Account.ChooseRoleModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Select Account Type";
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1>Placement Management System</h1>
        <p class="text-muted">
            Select your account type
        </p>
    </div>

    <div class="row justify-content-center">

        <!-- ================= STUDENT ================= -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <h3 class="mb-3">Student</h3>

                    <p class="text-muted">
                        Manage your profile, applications,
                        placements and opportunities.
                    </p>

                    <a asp-page="/Account/Login"
                       asp-route-role="Student"
                       class="btn btn-primary w-100 mb-2">
                        Student Login
                    </a>

                    <a asp-page="/Account/Register"
                       class="btn btn-outline-primary w-100">
                        Student Registration
                    </a>

                </div>

            </div>
        </div>


        <!-- ================= TPO ================= -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <h3 class="mb-3">TPO</h3>

                    <p class="text-muted">
                        Manage students, companies,
                        placements and recruitment activities.
                    </p>

                    <a asp-page="/Account/Login"
                       asp-route-role="TPO"
                       class="btn btn-success w-100 mb-2">
                        TPO Login
                    </a>

                    <a asp-page="/Account/TPORegister"
                       class="btn btn-outline-success w-100">
                        TPO Registration
                    </a>

                </div>

            </div>
        </div>


        <!-- ================= COMPANY ================= -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 text-center">

                <div class="card-body p-4">

                    <h3 class="mb-3">Company</h3>

                    <p class="text-muted">
                        Manage company details, job openings
                        and student applications.
                    </p>

                    <a asp-page="/Account/Login"
                       asp-route-role="Company"
                       class="btn btn-dark w-100 mb-2">
                        Company Login
                    </a>

                    <a asp-page="/Account/CompanyRegister"
                       class="btn btn-outline-dark w-100">
                        Company Registration
                    </a>

                </div>

            </div>
        </div>

    </div>

</div>