@page
@model PlacementManagementSystem.Areas.Identity.Pages.Account.TPORegisterModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "TPO Registration";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow">

                <div class="card-header bg-success text-white text-center">
                    <h3 class="mb-0">TPO Registration</h3>
                </div>

                <div class="card-body p-4">

                    <p class="text-muted text-center mb-4">
                        Create a Training and Placement Officer account.
                    </p>

                    <form method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="Input.FullName"
                                   class="form-label">
                                Full Name
                            </label>

                            <input asp-for="Input.FullName"
                                   class="form-control"
                                   placeholder="Enter full name" />

                            <span asp-validation-for="Input.FullName"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Input.Email"
                                   class="form-label">
                                Official Email
                            </label>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   placeholder="Enter official email" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Employee ID -->
                        <div class="mb-3">
                            <label asp-for="Input.EmployeeId"
                                   class="form-label">
                                Employee ID
                            </label>

                            <input asp-for="Input.EmployeeId"
                                   class="form-control"
                                   placeholder="Enter employee ID" />

                            <span asp-validation-for="Input.EmployeeId"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Department -->
                        <div class="mb-3">
                            <label asp-for="Input.Department"
                                   class="form-label">
                                Department
                            </label>

                            <input asp-for="Input.Department"
                                   class="form-control"
                                   placeholder="Enter department" />

                            <span asp-validation-for="Input.Department"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Input.Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   placeholder="Enter password" />

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label">
                                Confirm Password
                            </label>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm password" />

                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Create TPO Account
                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <span class="text-muted">
                            Already have a TPO account?
                        </span>

                        <a asp-page="/Account/Login"
                           asp-route-role="TPO">
                            Login here
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}