@using Microsoft.AspNetCore.Identity
@using PlacementManagementSystem.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- DASHBOARD -->

        <li class="nav-item">

            <a class="nav-link text-dark"
               asp-area=""
               asp-controller="Student"
               asp-action="Index">

                Dashboard

            </a>

        </li>


        <!-- PROFILE -->

        <li class="nav-item">

            <a class="nav-link text-dark"
               asp-area=""
               asp-controller="Student"
               asp-action="Profile">

                Profile

            </a>

        </li>


        <!-- LOGOUT -->

        <li class="nav-item">

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  method="post"
                  class="d-inline">

                <button type="submit"
                        class="btn btn-link nav-link text-dark"
                        style="border: none;">

                    Logout

                </button>

            </form>

        </li>
    }
    else
    {
        <!-- REGISTER -->

        <li class="nav-item">

            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Register">

                Register

            </a>

        </li>


        <!-- LOGIN -->

        <li class="nav-item">

            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">

                Login

            </a>

        </li>
    }

</ul>