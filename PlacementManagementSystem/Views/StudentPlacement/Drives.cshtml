@model IEnumerable<PlacementManagementSystem.Models.PlacementDrive>

@{
    ViewData["Title"] = "Placement Drives";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Placement Drives</h1>

            <p class="text-muted mb-0">
                View available placement drives and job opportunities.
            </p>
        </div>

        <div>
            <a href="/Student/Index"
               class="btn btn-secondary">
                ← Dashboard
            </a>
        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h5>No Placement Drives Available</h5>

            <p class="mb-0">
                There are currently no active placement drives.
            </p>
        </div>
    }
    else
    {
        @foreach (var drive in Model)
        {
            <div class="card shadow-sm mb-5">

                <div class="card-header bg-dark text-white">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h3 class="mb-1">
                                @drive.DriveName
                            </h3>

                            <small>
                                Placement Drive
                            </small>
                        </div>

                        <span class="badge bg-success align-self-start">
                            Active
                        </span>

                    </div>

                </div>


                <div class="card-body">

                    <div class="row mb-4">

                        <div class="col-md-4">
                            <strong>Drive Date</strong>

                            <p class="text-muted">
                                @drive.DriveDate.ToString("dd MMM yyyy")
                            </p>
                        </div>

                        <div class="col-md-4">
                            <strong>Venue</strong>

                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(drive.Venue)
                                    ? "Not specified"
                                    : drive.Venue)
                            </p>
                        </div>

                        <div class="col-md-4">
                            <strong>Status</strong>

                            <p>
                                <span class="badge bg-success">
                                    Active
                                </span>
                            </p>
                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(drive.Description))
                    {
                        <div class="alert alert-light border">
                            <strong>About this Drive</strong>

                            <p class="mb-0 mt-2">
                                @drive.Description
                            </p>
                        </div>
                    }


                    <hr />

                    <h4 class="mb-3">
                        Available Job Openings
                    </h4>


                    @if (drive.JobOpenings == null ||
                         !drive.JobOpenings.Any())
                    {
                        <div class="alert alert-warning">
                            No job openings have been added
                            to this placement drive yet.
                        </div>
                    }
                    else
                    {
                        <div class="row g-4">

                            @foreach (var job in drive.JobOpenings)
                            {
                                <div class="col-md-6">

                                    <div class="card h-100 border">

                                        <div class="card-header">

                                            <div class="d-flex justify-content-between">

                                                <h5 class="mb-0">
                                                    @job.JobTitle
                                                </h5>

                                                @if (job.IsActive)
                                                {
                                                    <span class="badge bg-success">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Inactive
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        <div class="card-body">

                                            <p>
                                                <strong>Company:</strong>

                                                @(job.Company?.CompanyName
                                                    ?? "Company not available")
                                            </p>


                                            <p>
                                                <strong>Location:</strong>

                                                @(string.IsNullOrWhiteSpace(job.JobLocation)
                                                    ? "Not specified"
                                                    : job.JobLocation)
                                            </p>


                                            <p>
                                                <strong>Employment Type:</strong>

                                                @(string.IsNullOrWhiteSpace(job.EmploymentType)
                                                    ? "Not specified"
                                                    : job.EmploymentType)
                                            </p>


                                            <p>
                                                <strong>Salary / Package:</strong>

                                                @if (job.SalaryPackage.HasValue)
                                                {
                                                    @job.SalaryPackage.Value.ToString("0.##")
                                                }
                                                else
                                                {
                                                    <span>Not specified</span>
                                                }
                                            </p>


                                            <hr />


                                            <h6 class="fw-bold">
                                                Eligibility
                                            </h6>


                                            <p class="mb-1">
                                                <strong>Minimum CGPA:</strong>
                                                @job.MinimumCGPA.ToString("0.00")
                                            </p>


                                            <p class="mb-1">
                                                <strong>Maximum Backlogs:</strong>
                                                @job.MaximumBacklogs
                                            </p>


                                            <p>
                                                <strong>Departments:</strong>

                                                @(string.IsNullOrWhiteSpace(job.EligibleDepartments)
                                                    ? "All Departments"
                                                    : job.EligibleDepartments)
                                            </p>


                                            @if (job.ApplicationDeadline.HasValue)
                                            {
                                                <p>
                                                    <strong>Application Deadline:</strong>

                                                    @job.ApplicationDeadline.Value
                                                    .ToString("dd MMM yyyy")
                                                </p>
                                            }


                                            @if (!string.IsNullOrWhiteSpace(job.Description))
                                            {
                                                <hr />

                                                <h6 class="fw-bold">
                                                    Job Description
                                                </h6>

                                                <p class="text-muted">
                                                    @job.Description
                                                </p>
                                            }


                                            <hr />


                                            @if (job.IsActive)
                                            {
                                                <form asp-controller="StudentPlacement"
                                                      asp-action="Apply"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@job.JobOpeningId" />

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-primary w-100">

                                                        Apply Now

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary w-100"
                                                        disabled>

                                                    Job Closed

                                                </button>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>