@model IEnumerable<PlacementManagementSystem.Models.PlacementApplication>

@{
    ViewData["Title"] = "My Applications";
}

<div class="container mt-4 mb-5">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>My Applications</h1>

            <p class="text-muted">
                Track your placement applications and their status.
            </p>
        </div>

        <div>

            <!-- Dashboard -->

            <a href="/Student/Index"
               class="btn btn-secondary">
                Dashboard
            </a>

            <!-- Browse Placement Drives -->

            <a href="/StudentPlacement/Drives"
               class="btn btn-primary">
                Browse Drives
            </a>

        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- No Applications -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">

            <h5>
                No applications yet.
            </h5>

            <p class="mb-3">
                You have not applied for any placement opportunity.
            </p>

            <a href="/StudentPlacement/Drives"
               class="btn btn-primary">
                Browse Placement Drives
            </a>

        </div>
    }
    else
    {
        <!-- Applications Table -->

        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">

                <h4 class="mb-0">
                    My Placement Applications
                </h4>

            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th>
                                    Job
                                </th>

                                <th>
                                    Company
                                </th>

                                <th>
                                    Placement Drive
                                </th>

                                <th>
                                    Applied Date
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var application in Model)
                            {
                                <tr>

                                    <!-- Job -->

                                    <td>
                                        <strong>
                                            @(application.JobOpening?.JobTitle
                                                ?? "Job not available")
                                        </strong>
                                    </td>


                                    <!-- Company -->

                                    <td>
                                        @(application.JobOpening?.Company?.CompanyName
                                            ?? "Company not available")
                                    </td>


                                    <!-- Placement Drive -->

                                    <td>
                                        @(application.JobOpening?.PlacementDrive?.DriveName
                                            ?? "General Placement")
                                    </td>


                                    <!-- Applied Date -->

                                    <td>
                                        @application.AppliedAt
                                        .ToLocalTime()
                                        .ToString("dd-MM-yyyy hh:mm tt")
                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (application.Status == "Selected")
                                        {
                                            <span class="badge bg-success">
                                                Selected
                                            </span>
                                        }
                                        else if (application.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else if (application.Status == "Shortlisted")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Shortlisted
                                            </span>
                                        }
                                        else if (application.Status == "Interview")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Interview
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                @(string.IsNullOrEmpty(application.Status)
                                                    ? "Applied"
                                                    : application.Status)
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>