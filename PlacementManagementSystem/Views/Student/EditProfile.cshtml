@model PlacementManagementSystem.Models.Student

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Edit Student Profile</h3>
                </div>

                <div class="card-body">

                    <form asp-controller="Student"
                          asp-action="EditProfile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ============================= -->
                        <!-- PERSONAL INFORMATION -->
                        <!-- ============================= -->

                        <h5 class="border-bottom pb-2 mb-4">
                            Personal Information
                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FullName"
                                       class="form-label">
                                </label>

                                <input asp-for="FullName"
                                       class="form-control" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="RollNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="RollNumber"
                                       class="form-control" />

                                <span asp-validation-for="RollNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Department"
                                       class="form-label">
                                </label>

                                <input asp-for="Department"
                                       class="form-control" />

                                <span asp-validation-for="Department"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="PhoneNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="DateOfBirth"
                                       class="form-label">
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Gender"
                                       class="form-label">
                                </label>

                                <select asp-for="Gender"
                                        class="form-select">

                                    <option value="">
                                        Select Gender
                                    </option>

                                    <option value="Male">
                                        Male
                                    </option>

                                    <option value="Female">
                                        Female
                                    </option>

                                    <option value="Other">
                                        Other
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- ADDRESS -->
                        <!-- ============================= -->

                        <h5 class="border-bottom pb-2 mb-4 mt-4">
                            Address Information
                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="PresentAddress"
                                       class="form-label">
                                </label>

                                <textarea asp-for="PresentAddress"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="PresentAddress"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="PermanentAddress"
                                       class="form-label">
                                </label>

                                <textarea asp-for="PermanentAddress"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="PermanentAddress"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- EMERGENCY CONTACT -->
                        <!-- ============================= -->

                        <h5 class="border-bottom pb-2 mb-4 mt-4">
                            Emergency Contact
                        </h5>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="EmergencyContactName"
                                       class="form-label">
                                </label>

                                <input asp-for="EmergencyContactName"
                                       class="form-control" />

                                <span asp-validation-for="EmergencyContactName"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="EmergencyContactNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="EmergencyContactNumber"
                                       class="form-control" />

                                <span asp-validation-for="EmergencyContactNumber"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- ACADEMIC INFORMATION -->
                        <!-- ============================= -->

                        <h5 class="border-bottom pb-2 mb-4 mt-4">
                            Academic Information
                        </h5>

                        <div class="row">

                            <div class="col-md-4 mb-3">

                                <label asp-for="TenthPercentage"
                                       class="form-label">
                                </label>

                                <input asp-for="TenthPercentage"
                                       class="form-control"
                                       type="number"
                                       step="0.01" />

                                <span asp-validation-for="TenthPercentage"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="TwelfthPercentage"
                                       class="form-label">
                                </label>

                                <input asp-for="TwelfthPercentage"
                                       class="form-control"
                                       type="number"
                                       step="0.01" />

                                <span asp-validation-for="TwelfthPercentage"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="DiplomaPercentage"
                                       class="form-label">
                                </label>

                                <input asp-for="DiplomaPercentage"
                                       class="form-control"
                                       type="number"
                                       step="0.01" />

                                <span asp-validation-for="DiplomaPercentage"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="CurrentCGPA"
                                       class="form-label">
                                </label>

                                <input asp-for="CurrentCGPA"
                                       class="form-control"
                                       type="number"
                                       step="0.01" />

                                <span asp-validation-for="CurrentCGPA"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="ActiveBacklogs"
                                       class="form-label">
                                </label>

                                <input asp-for="ActiveBacklogs"
                                       class="form-control"
                                       type="number"
                                       min="0" />

                                <span asp-validation-for="ActiveBacklogs"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-4 mb-3">

                                <label asp-for="ClearedBacklogs"
                                       class="form-label">
                                </label>

                                <input asp-for="ClearedBacklogs"
                                       class="form-control"
                                       type="number"
                                       min="0" />

                                <span asp-validation-for="ClearedBacklogs"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="PassingYear"
                                       class="form-label">
                                </label>

                                <input asp-for="PassingYear"
                                       class="form-control"
                                       type="number" />

                                <span asp-validation-for="PassingYear"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="Specialization"
                                       class="form-label">
                                </label>

                                <input asp-for="Specialization"
                                       class="form-control" />

                                <span asp-validation-for="Specialization"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- SKILLS -->
                        <!-- ============================= -->

                        <h5 class="border-bottom pb-2 mb-4 mt-4">
                            Skills & Social Profiles
                        </h5>

                        <div class="mb-3">

                            <label asp-for="Skills"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Skills"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Example: C#, ASP.NET Core, SQL Server, HTML, CSS"></textarea>

                            <span asp-validation-for="Skills"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="GitHubUrl"
                                       class="form-label">
                                </label>

                                <input asp-for="GitHubUrl"
                                       class="form-control"
                                       placeholder="https://github.com/username" />

                                <span asp-validation-for="GitHubUrl"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="LinkedInUrl"
                                       class="form-label">
                                </label>

                                <input asp-for="LinkedInUrl"
                                       class="form-control"
                                       placeholder="https://linkedin.com/in/username" />

                                <span asp-validation-for="LinkedInUrl"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- BUTTONS -->
                        <!-- ============================= -->

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-success">

                                Save Changes

                            </button>


                            <a asp-controller="Student"
                               asp-action="Profile"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}