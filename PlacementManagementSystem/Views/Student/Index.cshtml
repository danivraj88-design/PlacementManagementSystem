@model PlacementManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-4 mb-5">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h1>Student Dashboard</h1>

            <p class="text-muted">
                Welcome, @Model.FullName!
            </p>
        </div>

        <div>
            <a asp-controller="Student"
               asp-action="Profile"
               class="btn btn-primary">
                My Profile
            </a>
        </div>

    </div>


    <!-- Main Dashboard Cards -->
    <div class="row mb-4">

        <!-- My Profile -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h3 class="card-title">
                        👤 My Profile
                    </h3>

                    <p class="card-text text-muted">
                        View and update your personal and academic
                        information.
                    </p>

                    <a asp-controller="Student"
                       asp-action="Profile"
                       class="btn btn-outline-primary">
                        View Profile
                    </a>

                </div>

            </div>

        </div>


        <!-- Placement Drives -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h3 class="card-title">
                        💼 Placement Drives
                    </h3>

                    <p class="card-text text-muted">
                        View available company placement drives
                        and job opportunities.
                    </p>

                    <a asp-controller="StudentPlacement"
                       asp-action="Drives"
                       class="btn btn-outline-success">
                        View Placement Drives
                    </a>

                </div>

            </div>

        </div>


        <!-- My Applications -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h3 class="card-title">
                        📋 My Applications
                    </h3>

                    <p class="card-text text-muted">
                        Track your placement applications
                        and their current status.
                    </p>

                    <a asp-controller="StudentPlacement"
                       asp-action="Applications"
                       class="btn btn-outline-warning">
                        View Applications
                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Academic Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                Academic Information
            </h3>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- Roll Number -->
                <div class="col-md-4 mb-4">

                    <strong>
                        Roll Number
                    </strong>

                    <p class="mb-0">
                        @Model.RollNumber
                    </p>

                </div>


                <!-- Department -->
                <div class="col-md-4 mb-4">

                    <strong>
                        Department
                    </strong>

                    <p class="mb-0">
                        @Model.Department
                    </p>

                </div>


                <!-- CGPA -->
                <div class="col-md-4 mb-4">

                    <strong>
                        Current CGPA
                    </strong>

                    <p class="mb-0">

                        @if (Model.CurrentCGPA.HasValue)
                        {
                            @Model.CurrentCGPA.Value.ToString("0.00")
                        }
                        else
                        {
                            <span>Not entered</span>
                        }

                    </p>

                </div>


                <!-- 10th -->
                <div class="col-md-4 mb-4">

                    <strong>
                        10th Percentage
                    </strong>

                    <p class="mb-0">

                        @if (Model.TenthPercentage.HasValue)
                        {
                            @Model.TenthPercentage.Value.ToString("0.00")
                        }
                        else
                        {
                            <span>Not entered</span>
                        }

                    </p>

                </div>


                <!-- 12th -->
                <div class="col-md-4 mb-4">

                    <strong>
                        12th Percentage
                    </strong>

                    <p class="mb-0">

                        @if (Model.TwelfthPercentage.HasValue)
                        {
                            @Model.TwelfthPercentage.Value.ToString("0.00")
                        }
                        else
                        {
                            <span>Not entered</span>
                        }

                    </p>

                </div>


                <!-- Active Backlogs -->
                <div class="col-md-4 mb-4">

                    <strong>
                        Active Backlogs
                    </strong>

                    <p class="mb-0">
                        @Model.ActiveBacklogs
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Profile Status -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h3>
                Profile Status
            </h3>

            @if (Model.IsProfileVerified)
            {
                <span class="badge bg-success">
                    Verified
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">
                    Not Verified
                </span>
            }

        </div>

    </div>

</div>