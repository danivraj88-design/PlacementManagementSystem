@model IEnumerable<PlacementManagementSystem.Models.PlacementDrive>

@{
    ViewData["Title"] = "Placement Drives";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Placement Drives</h1>
            <p class="text-muted">
                Create and manage placement drives.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-primary">
                + Create Drive
            </a>

            <a asp-controller="TPO"
               asp-action="Index"
               class="btn btn-secondary">
                Dashboard
            </a>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No placement drives created yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var drive in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <h4>
                                @drive.DriveName
                            </h4>

                            <p>
                                @drive.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @drive.DriveDate.ToString("dd-MM-yyyy")
                            </p>

                            <p>
                                <strong>Venue:</strong>
                                @drive.Venue
                            </p>

                            <p>
                                <strong>Job Openings:</strong>
                                @drive.JobOpenings.Count
                            </p>

                            @if (drive.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactive
                                </span>
                            }

                            <div class="mt-3">

                                <a asp-action="Details"
                                   asp-route-id="@drive.PlacementDriveId"
                                   class="btn btn-primary btn-sm">
                                    View
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@drive.PlacementDriveId"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>