@model IEnumerable<PlacementManagementSystem.Models.JobOpening>

@{
    ViewData["Title"] = "Job Openings";
}

<div class="container mt-5 mb-5">

    <!-- ============================
         PAGE HEADER
         ============================ -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Job Openings</h1>

            <p class="text-muted mb-0">
                Manage your company's placement job openings.
            </p>
        </div>

        <div>

            <!-- Create Job -->

            <a asp-controller="Company"
               asp-action="Create"
               class="btn btn-dark me-2">
                + Create Job Opening
            </a>

            <!-- Dashboard -->

            <a asp-controller="Company"
               asp-action="Index"
               class="btn btn-outline-dark">
                ← Dashboard
            </a>

        </div>

    </div>


    <!-- ============================
         SUCCESS MESSAGE
         ============================ -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <strong>Success:</strong>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================
         ERROR MESSAGE
         ============================ -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <strong>Error:</strong>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ============================
         NO JOBS
         ============================ -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h4>
                    No Job Openings Yet
                </h4>

                <p class="text-muted">
                    Your company has not created any job openings yet.
                </p>

                <a asp-controller="Company"
                   asp-action="Create"
                   class="btn btn-dark mt-2">
                    + Create Your First Job Opening
                </a>

            </div>

        </div>
    }
    else
    {
        <!-- ============================
             JOB LIST
             ============================ -->

        <div class="row g-4">

            @foreach (var job in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <!-- Job Header -->

                        <div class="card-header bg-dark text-white">

                            <div class="d-flex justify-content-between
                                align-items-center">

                                <h5 class="mb-0">
                                    @job.JobTitle
                                </h5>

                                @if (job.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </div>

                        </div>


                        <!-- Job Body -->

                        <div class="card-body">

                            <!-- Company -->

                            <p>
                                <strong>Company ID:</strong>
                                @job.CompanyId
                            </p>


                            <!-- Job Location -->

                            <p>
                                <strong>Location:</strong>

                                @(string.IsNullOrEmpty(job.JobLocation)
                                    ? "Not specified"
                                    : job.JobLocation)
                            </p>


                            <!-- Employment Type -->

                            <p>
                                <strong>Employment Type:</strong>

                                @(string.IsNullOrEmpty(job.EmploymentType)
                                    ? "Not specified"
                                    : job.EmploymentType)
                            </p>


                            <!-- Salary -->

                            <p>
                                <strong>Salary / Package:</strong>

                                @if (job.SalaryPackage.HasValue)
                                {
                                    @job.SalaryPackage.Value.ToString("0.##")
                                }
                                else
                                {
                                    <span>
                                        Not specified
                                    </span>
                                }

                            </p>


                            <hr />


                            <!-- Eligibility -->

                            <h6 class="fw-bold">
                                Eligibility
                            </h6>

                            <p class="mb-2">

                                <strong>Minimum CGPA:</strong>

                                @job.MinimumCGPA.ToString("0.00")

                            </p>


                            <p class="mb-2">

                                <strong>Maximum Backlogs:</strong>

                                @job.MaximumBacklogs

                            </p>


                            <p class="mb-2">

                                <strong>Eligible Departments:</strong>

                                @(string.IsNullOrEmpty(job.EligibleDepartments)
                                    ? "All Departments"
                                    : job.EligibleDepartments)

                            </p>


                            <!-- Placement Drive -->

                            <hr />

                            <h6 class="fw-bold">
                                Placement Drive
                            </h6>

                            @if (job.PlacementDrive != null)
                            {
                                <div class="alert alert-light border">

                                    <strong>
                                        @job.PlacementDrive.DriveName
                                    </strong>

                                    <br />

                                    <small class="text-muted">

                                        Drive Date:

                                        @job.PlacementDrive.DriveDate
                                        .ToString("dd MMM yyyy")

                                    </small>

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">

                                    No placement drive assigned.

                                </div>
                            }


                            <!-- Application Deadline -->
                            @if (job.ApplicationDeadline.HasValue)
                            {
                                <p>

                                    <strong>
                                        Application Deadline:
                                    </strong>

                                    @job.ApplicationDeadline.Value
                                    .ToString("dd-MM-yyyy")

                                </p>
                            }
                            else
                            {
                                <p>

                                    <strong>
                                        Application Deadline:
                                    </strong>

                                    No deadline specified.

                                </p>
                            }


                            <!-- Description -->
                            @if (!string.IsNullOrWhiteSpace(job.Description))
                            {
                                <hr />

                                <h6 class="fw-bold">
                                    Job Description
                                </h6>

                                <p class="text-muted">
                                    @job.Description
                                </p>
                            }


                            <!-- Job Created -->

                            <hr />

                            <p class="text-muted mb-0">

                                <small>

                                    Created:
                                    @job.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")

                                </small>

                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>